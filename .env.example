# Application
APP_NAME=OpenTime
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://opentime:opentime@localhost:5432/opentime

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT – generate a secure key for production: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=opentime-memories
S3_REGION=us-east-1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
