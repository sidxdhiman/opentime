APP_NAME=OpenTime
DEBUG=true

# ── SQL Database (auth / users) ───────────────────────────────────────────────
# Local dev without Docker — uses SQLite for zero-friction setup.
# To use Postgres instead, uncomment and point at your instance.
DATABASE_URL=sqlite+aiosqlite:///./opentime-dev.db
# DATABASE_URL=postgresql+asyncpg://opentime:opentime@localhost:5432/opentime

# ── MongoDB (Chronos state, onboarding, memories) ────────────────────────────
# For local dev without Docker, install MongoDB or use MongoDB Atlas free tier.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=opentime

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure key for production: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── S3-compatible storage (MinIO in dev) ─────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=opentime-memories
S3_REGION=us-east-1

# ── LLM & Embeddings (optional) ──────────────────────────────────────────────
# If not set, the system uses mock implementations (safe for development).
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
