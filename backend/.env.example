APP_NAME=OpenTime
DEBUG=true

# Local dev without Docker — uses SQLite for zero-friction setup.
# To use Postgres instead, point at your instance, e.g.:
# DATABASE_URL=postgresql+asyncpg://opentime:opentime@localhost:5432/opentime
DATABASE_URL=sqlite+aiosqlite:///./opentime-dev.db

REDIS_URL=redis://localhost:6379/0

# JWT – generate a secure key for production: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS – comma-separated or JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=opentime-memories
S3_REGION=us-east-1